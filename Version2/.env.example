# Postgres connection string (Neon, Supabase, Vercel Postgres, ...)
#
# Required at RUNTIME by /api/health and any future database-backed routes.
# `next build` succeeds without it — the database is simply reported as
# "not configured" until you add this variable.
#
# Add it in Vercel: Project → Settings → Environment Variables, then redeploy.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
